# ---------------------------------------------------------------------------
# Copy this file to .env and fill in at least ONE key. All of these have free tiers.
# Never commit .env to GitHub (it's already in .gitignore).
# ---------------------------------------------------------------------------

# Order the agent tries providers in. If one fails or hits a rate limit, it falls back to the next.
LLM_PROVIDERS=gemini,groq,cohere,openrouter,ollama

# 1) Google Gemini: recommended primary (free, no card)  →  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # or a specific one, e.g. gemini-3.8-flash

# 2) Groq: recommended backup (free, very fast; phone verification)  →  https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 3) Cohere: optional (free trial key: 1,000 calls/month, non-commercial)  →  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# 4) OpenRouter: optional (free ':free' models, ~50 requests/day)  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5) Ollama: optional, fully local and no key (install from ollama.com, then: ollama pull llama3.1)
OLLAMA_ENABLED=0
# OLLAMA_MODEL=llama3.1

# Optional (career coach only): broad job search incl. Big Tech  →  https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Voice mode (optional): coach voice for text-to-speech
# COACH_VOICE=en-US-AriaNeural     # e.g. en-US-GuyNeural, en-IN-NeerjaNeural, en-GB-SoniaNeural
